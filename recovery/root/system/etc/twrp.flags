# ============================================================
# Samsung A35x - A/B + Dynamic Partitions + FBE
# ============================================================

# ------------------------------------------------------------
# BOOT / RECOVERY
# ------------------------------------------------------------
/dev/block/bootdevice/by-name/boot        /boot        emmc  defaults                          defaults
/dev/block/bootdevice/by-name/recovery    /recovery    emmc  defaults                          defaults

# ------------------------------------------------------------
# DYNAMIC PARTITIONS (SUPER LOGICAL)
# IMPORTANT: MUST USE "logical" + "first_stage_mount"
# ------------------------------------------------------------
/dev/block/mapper/system      /system      ext4  ro,barrier=1     wait,logical,first_stage_mount
/dev/block/mapper/system_ext  /system_ext  ext4  ro,barrier=1     wait,logical,first_stage_mount
/dev/block/mapper/product     /product     ext4  ro,barrier=1     wait,logical,first_stage_mount
/dev/block/mapper/vendor      /vendor      ext4  ro,barrier=1     wait,logical,first_stage_mount
/dev/block/mapper/odm         /odm         ext4  ro,barrier=1     wait,logical,first_stage_mount
/dev/block/mapper/vendor_dlkm /vendor_dlkm ext4  ro,barrier=1     wait,logical,first_stage_mount

# ------------------------------------------------------------
# DATA (FBE ENCRYPTION FIX - CRITICAL)
# ------------------------------------------------------------
/dev/block/bootdevice/by-name/userdata    /data    f2fs  noatime,nosuid,nodev,discard,inlinecrypt  wait,check,formattable,quota,latemount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt,metadata_encryption=aes-256-xts,encryptable=footer

# ------------------------------------------------------------
# METADATA (CRITICAL FOR CRYPTO FOOTER)
# ------------------------------------------------------------
/dev/block/bootdevice/by-name/metadata     /metadata ext4  noatime,nosuid,nodev,discard  wait,formattable

# ------------------------------------------------------------
# EXTERNAL STORAGE
# ------------------------------------------------------------
/devices/platform/*usb*           /usb_otg      auto  defaults   voldmanaged=usb:auto
/dev/block/mmcblk1               /external_sd   auto  defaults   voldmanaged=sdcard1:auto
