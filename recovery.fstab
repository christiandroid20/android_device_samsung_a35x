# Android fstab file.
#<src>                  <mnt_point>         <type>    <mnt_flags and options>    <fs_mgr_flags>

system          /system          erofs  ro  wait,logical,first_stage_mount
vendor          /vendor          erofs  ro  wait,logical,first_stage_mount
product         /product         erofs  ro  wait,logical,first_stage_mount
odm             /odm             erofs  ro  wait,logical,first_stage_mount
system_ext      /system_ext      erofs  ro  wait,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm     erofs  ro  wait,logical,first_stage_mount
system_dlkm     /system_dlkm     erofs  ro  wait,logical,first_stage_mount

/dev/block/by-name/boot          /boot            emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/init_boot     /init_boot        emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/vendor_boot   /vendor_boot      emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/dtbo          /dtbo             emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/vbmeta        /vbmeta           emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/vbmeta_system /vbmeta_system    emmc  defaults  first_stage_mount,formattable
/dev/block/by-name/recovery      /recovery         emmc  defaults  first_stage_mount
/dev/block/by-name/misc          /misc             emmc  defaults  defaults,first_stage_mount

/dev/block/by-name/metadata  /metadata  ext4  noatime,nosuid,nodev,discard,journal_checksum,data=ordered,errors=panic,sync  wait,formattable,first_stage_mount,check

/dev/block/by-name/userdata  /data  ext4  noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,whint_mode=fs-based,inlinecrypt  latemount,wait,check,quota,reservedsize=128M,checkpoint=fs,fscompress,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption

/dev/block/by-name/cache  /cache  ext4  noatime,nosuid,nodev,discard,journal_checksum,data=ordered,errors=panic  wait,formattable,check

/dev/block/by-name/efs      /efs       ext4  noatime,nosuid,nodev,discard,journal_checksum,data=ordered,errors=panic  wait,formattable,check
/dev/block/by-name/sec_efs  /sec_efs   ext4  noatime,nosuid,nodev,discard,journal_checksum,data=ordered,errors=panic  wait,formattable,check
/dev/block/by-name/modem    /modem     emmc  defaults  defaults,first_stage_mount

/devices/platform/*sdcc2*/mmc_host*  /external_sd  vfat  nosuid,nodev  voldmanaged=sdcard1:auto
