# =========================================================
# SYSTEM / DYNAMIC PARTITIONS
# =========================================================
system        /system        erofs   ro,logical,wait
vendor        /vendor        erofs   ro,logical,wait
product       /product       erofs   ro,logical,wait
odm           /odm           erofs   ro,logical,wait

system_dlkm   /system_dlkm   erofs   ro,logical,wait
vendor_dlkm   /vendor_dlkm   erofs   ro,logical,wait

# =========================================================
# BOOT PARTITIONS
# =========================================================
/dev/block/by-name/boot          /boot          emmc  defaults  wait,formattable
/dev/block/by-name/init_boot     /init_boot     emmc  defaults  wait,formattable
/dev/block/by-name/vendor_boot   /vendor_boot   emmc  defaults  wait,formattable
/dev/block/by-name/dtbo         /dtbo          emmc  defaults  wait,formattable
/dev/block/by-name/vbmeta       /vbmeta        emmc  defaults  wait
/dev/block/by-name/vbmeta_system /vbmeta_system emmc  defaults  wait

# =========================================================
# CRITICAL PARTITIONS
# =========================================================
/dev/block/by-name/metadata     /metadata      ext4  noatime,nosuid,nodev,discard,formattable,wait

/dev/block/by-name/userdata     /data          f2fs  noatime,nosuid,nodev,discard,inlinecrypt,fscrypt=aes-256-xts:aes-256-cts:v2,quota,latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts

/dev/block/by-name/cache        /cache         ext4  noatime,nosuid,nodev,discard,formattable,wait

# =========================================================
# SAMSUNG SPECIAL PARTITIONS
# =========================================================
/dev/block/by-name/efs          /efs           ext4  noatime,nosuid,nodev,wait
/dev/block/by-name/cpefs        /cpefs         ext4  noatime,nosuid,nodev,wait

/dev/block/by-name/misc         /misc          emmc  defaults
/dev/block/by-name/recovery     /recovery      emmc  defaults

/dev/block/by-name/keystorage   /keystorage    emmc  defaults
/dev/block/by-name/harx         /harx          emmc  defaults

# =========================================================
# CSC (OPTIONAL)
# =========================================================
/dev/block/by-name/prism        /prism         ext4  ro,wait
/dev/block/by-name/optics       /optics        ext4  ro,wait
